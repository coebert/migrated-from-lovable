{
  "name": "Referral",
  "type": "object",
  "properties": {
    "patient_initials": {
      "type": "string"
    },
    "hospital_number": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other",
        "unknown"
      ]
    },
    "current_ward": {
      "type": "string"
    },
    "current_bed": {
      "type": "string"
    },
    "referring_specialty": {
      "type": "string"
    },
    "reason_for_referral": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "admitted",
        "declined"
      ],
      "default": "pending"
    },
    "admission_urgency": {
      "type": "string",
      "enum": [
        "within_15_min",
        "within_30_min",
        "within_1_hour",
        "within_1_2_hours",
        "not_admitting"
      ]
    },
    "referral_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "string"
    },
    "arrived_on_unit_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepting_consultant": {
      "type": "string",
      "title": "Accepting consultant"
    },
    "discussed_with_consultant": {
      "type": "string"
    },
    "taken_by": {
      "type": "string"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_test": {
      "type": "boolean",
      "default": false
    },
    "urgency": {
      "type": "string",
      "enum": [
        "emergency",
        "urgent",
        "routine"
      ],
      "default": "routine"
    },
    "referral_reason": {
      "type": "string"
    },
    "source_ward": {
      "type": "string"
    },
    "referring_team": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "patient_initials",
    "reason_for_referral"
  ]
}