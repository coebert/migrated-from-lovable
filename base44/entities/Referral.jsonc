{
  "name": "Referral",
  "type": "object",
  "properties": {
    "patient_initials": {
      "type": "string"
    },
    "hospital_number": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other",
        "unknown"
      ]
    },
    "current_ward": {
      "type": "string"
    },
    "current_bed": {
      "type": "string"
    },
    "referring_specialty": {
      "type": "string"
    },
    "reason_for_referral": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "admitted",
        "declined"
      ],
      "default": "pending"
    },
    "admission_urgency": {
      "type": "string",
      "enum": [
        "within_15_min",
        "within_30_min",
        "within_1_hour",
        "within_1_2_hours",
        "not_admitting"
      ]
    },
    "referral_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "admit_for_admission",
        "review_on_ward",
        "advice_given",
        "declined"
      ]
    },
    "decline_reason": {
      "type": "string"
    },
    "reason_notes": {
      "type": "string"
    },
    "arrived_on_unit_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepting_consultant": {
      "type": "string",
      "title": "Accepting consultant"
    },
    "discussed_with_consultant": {
      "type": "string"
    },
    "taken_by": {
      "type": "string"
    },
    "news2_score": {
      "type": "number"
    },
    "ceiling_of_care": {
      "type": "string",
      "enum": [
        "full_escalation",
        "no_cpr",
        "ward_based",
        "symptom_control",
        "not_documented"
      ]
    },
    "reason_category": {
      "type": "string",
      "enum": [
        "respiratory_failure",
        "sepsis",
        "shock",
        "post_op",
        "neurology",
        "trauma",
        "gi_bleed",
        "metabolic",
        "overdose",
        "other"
      ]
    },
    "frailty_score": {
      "type": "number"
    },
    "anticipated_interventions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "infection_status": {
      "type": "string",
      "enum": [
        "none",
        "suspected",
        "confirmed",
        "unknown"
      ]
    },
    "infection_organism": {
      "type": "string"
    },
    "weight_kg": {
      "type": "number"
    },
    "allergies": {
      "type": "string"
    },
    "resus_status": {
      "type": "string",
      "enum": [
        "for_cpr",
        "dnacpr",
        "not_documented"
      ]
    },
    "needs_ward_review": {
      "type": "boolean",
      "default": false
    },
    "for_ongoing_ccot_review": {
      "type": "boolean",
      "default": false
    },
    "ward_review_timeframe": {
      "type": "string",
      "enum": [
        "12h",
        "24h",
        "48h",
        "72h",
        "weekly",
        "prn"
      ]
    },
    "past_medical_history": {
      "type": "string"
    },
    "baseline_function": {
      "type": "string"
    },
    "dnacpr_respect": {
      "type": "string"
    },
    "consultant_to_consultant_only": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_test": {
      "type": "boolean",
      "default": false
    },
    "urgency": {
      "type": "string",
      "enum": [
        "emergency",
        "urgent",
        "routine"
      ],
      "default": "routine"
    },
    "referral_reason": {
      "type": "string"
    },
    "source_ward": {
      "type": "string"
    },
    "referring_team": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "patient_initials",
    "reason_for_referral"
  ]
}